{
  "manifest_version": 3,
  "name": "Filler Cut",
  "version": "0.0.2",
  "permissions": ["storage", "activeTab", "scripting"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "action": {},
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+F" }
    }
  },
  "background": {
    "service_worker": "sw.js"
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://claude.com/*"],
      "js": ["main.js"]
    }
  ]
}
