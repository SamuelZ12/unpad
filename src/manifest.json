{
  "manifest_version": 3,
  "name": "Filler Cut",
  "version": "0.3.1",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "commands": {
    "toggle-lens": {
      "suggested_key": {
        "default": "Alt+Shift+F"
      },
      "description": "Toggle Filler Cut on this page"
    }
  },
  "background": {
    "service_worker": "sw.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://claude.com/*"
      ],
      "js": [
        "main.js"
      ]
    }
  ]
}
